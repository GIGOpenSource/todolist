# Production / staging template — copy to backend/.env and fill real values.
# Never commit the real .env.

APP_ENV=pro
SECRET_KEY=replace-with-at-least-32-random-chars-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

DATABASE_URL=postgresql+psycopg://upgrade:CHANGE_ME@127.0.0.1:5432/upgrade
REDIS_URL=redis://127.0.0.1:6379/0
WEB_CONCURRENCY=2

# Real public origins only — no *
CORS_ORIGINS=https://www.example.com,https://app.example.com,https://admin.example.com

ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional
# LLM_API_KEY=
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_PUBLIC_BASE_URL=
