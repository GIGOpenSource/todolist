# Copy to backend/.env and fill real values. Never commit .env.

# APP_ENV=dev
# APP_ENV=pro

# Security (required when APP_ENV=pro)
SECRET_KEY=replace-with-at-least-32-random-chars-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# Database — Postgres DSN. Local sqlite / 127.0.0.1 are rejected at startup
# unless ALLOW_LOCAL_DB=1 (emergency).
DATABASE_URL=postgresql+psycopg://upgrade:change-me@127.0.0.1:5432/upgrade
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# ALLOW_LOCAL_DB=0

# Redis — required when WEB_CONCURRENCY > 1 under APP_ENV=pro
REDIS_URL=redis://127.0.0.1:6379/0

# CORS — comma-separated or JSON list; production forbids *
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5181,http://localhost:5181,http://127.0.0.1:4173,http://localhost:4173

WEB_CONCURRENCY=2

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate limits (per minute)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SYNC_PER_MINUTE=60
RATE_LIMIT_REPORT_PER_MINUTE=10

ACCOUNT_PURGE_INTERVAL_SECONDS=3600

# Optional LLM for AI reports (OpenAI-compatible)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=60

# S3-compatible object storage (avatar upload)
# OSS_ENDPOINT=http://127.0.0.1:9000
# OSS_ENDPOINT_PUBLIC=http://127.0.0.1:9000
# OSS_BUCKET=upgrade
# OSS_ACCESS_KEY=change-me
# OSS_SECRET_KEY=change-me
# OSS_REGION=us-east-1
# OSS_PUBLIC_BASE_URL=http://127.0.0.1:9000/upgrade
# OSS_PREFIX=avatars/
