# Optional reverse proxy. Copy and fill your domain / certificate paths.
# This file has no production hostnames or certs.

server {
    listen 80;
    server_name example.com www.example.com;
    client_max_body_size 8m;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location /docs {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    location /openapi.json {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    location /upgrade/ {
        proxy_pass http://127.0.0.1:9000/upgrade/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        client_max_body_size 8m;
    }

    location /h5/ {
        alias /var/www/upgrade/web-pc/;
        index index.html;
        try_files $uri $uri/ /h5/index.html;
    }

    location /admin/ {
        alias /var/www/upgrade/web-admin/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    location /app/ {
        alias /var/www/upgrade/app/;
        index index.html;
    }

    location / {
        root /var/www/upgrade/website;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
